# --- LLM: pick one provider ---
LLM_PROVIDER=groq

# Groq (free, no card): https://console.groq.com
# Note: llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17.
# Check https://console.groq.com/docs/models for the current free-tier list.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM (free, no card, phone verification required): https://build.nvidia.com
# ~40 requests/minute shared across models. Terms restrict free use to dev/test/
# research/evaluation, not production end-user traffic (same practical caveat as Groq).
# NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Flights & hotels ---
# Duffel (free test mode, no card): https://duffel.com
# Create a test access token (starts with "duffel_test_") from your Duffel dashboard.
# Test tokens only return simulated data — swap for a "duffel_live_..." key to go live.
DUFFEL_API_KEY=duffel_test_your_duffel_api_key
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2

# --- Email delivery (free tier: 100 emails/day, 3,000/month) ---
# Create a free key at https://resend.com (Dashboard -> API Keys)
RESEND_API_KEY=your_resend_api_key

# --- Observability (optional, free tier) ---
# https://smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai-travel-agent

# --- App behaviour ---
# Max number of tool-call round-trips per user query, to bound cost/latency
MAX_TOOL_ITERATIONS=6
# Seconds a flight/hotel search result is cached for, to avoid duplicate API calls
SEARCH_CACHE_TTL_SECONDS=900
LOG_LEVEL=INFO
